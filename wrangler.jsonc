{
  "name": "diamondtier",
  "main": "src/worker.js",
  "compatibility_date": "2025-10-01",
  "ai": { "binding": "AI" },
  "vars": { "SKIN_HELPER": "https://diamondtier-skins.vercel.app" },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/players.json", "/api/*"]
  }
}
